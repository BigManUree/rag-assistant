# 阿里云百炼 MaaS（OpenAI 兼容模式）API Key
# 控制台：https://bailian.console.aliyun.com/ -> API-KEY
LLM_API_KEY=your_key_here
LLM_BASE_URL=https://<your-endpoint>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 模型可按需替换（需在该空间已开通）
CHAT_MODEL=qwen3.8-flash
EMBEDDING_MODEL=qwen3.7-text-embedding-flash

# embedding 单批条数（百炼/通义上限 20，超限会自动降批）
EMBED_BATCH_SIZE=10
